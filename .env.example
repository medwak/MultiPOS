# Copy to .env and fill in. Values here override what is saved in Settings > M-Pesa.
# SECRET_KEY=change-me-to-a-long-random-string
# PORT=5000
# MPESA_MODE=sandbox            # simulate | sandbox | production
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline
# MPESA_PARTY_B=                # Till number for Buy Goods
# MPESA_CALLBACK_BASE=https://your-name.ngrok-free.app
